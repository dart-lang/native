{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "package:web_assets party:shared shared definitions",
  "definitions": {
    "Asset": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "anyOf": [
            {
              "const": "web_assets/web"
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "web_assets/web"
              }
            }
          },
          "then": {
            "properties": {
              "encoding": {
                "$ref": "#/definitions/WebAssetEncoding"
              }
            }
          }
        }
      ]
    },
    "WebAssetEncoding": {
      "type": "object",
      "properties": {
        "file": {
          "$ref": "../../../../hooks/doc/schema/shared/shared_definitions.schema.json#/definitions/absolutePath"
        },
        "name": {
          "type": "string"
        },
        "package": {
          "type": "string"
        }
      },
      "required": [
        "file",
        "name",
        "package"
      ]
    }
  }
}
